{
  "name": "github-model-relay",
  "version": "0.2.5",
  "private": true,
  "description": "Unofficial GitHub Model Relay desktop app and headless gateway.",
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "npm run test:gateway && npm run test:npm && npm run test:desktop",
    "test:gateway": "node --test --test-concurrency=1 tests/node/*.test.mjs",
    "test:npm": "node --test packages/npm/tests/*.test.mjs",
    "test:runtime": "node --test --test-concurrency=1 tests/node/supervisor.test.mjs",
    "test:desktop": "npm test --workspace @github-model-relay/desktop",
    "typecheck:desktop": "npm run typecheck --workspace @github-model-relay/desktop",
    "build:desktop": "npm run build --workspace @github-model-relay/desktop",
    "pack:desktop": "npm run pack --workspace @github-model-relay/desktop",
    "dist:desktop": "npm run dist --workspace @github-model-relay/desktop"
  },
  "dependencies": {
    "@jeffreycao/copilot-api": "2.0.1",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.7.1"
  }
}
